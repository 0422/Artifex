# ========== 应用 ==========
# 2026-09-29 APP_NAME 已移除：产品名改由 backend/app/core/constants.py 的 PRODUCT_NAME 统一提供，
# 此处不再覆盖，更名只改 constants.py 一处
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://lingua:lingua_dev@localhost:5432/lingua_dev
DATABASE_URL_SYNC=postgresql://lingua:lingua_dev@localhost:5432/lingua_dev

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== AI ==========
# 若通过中转站接入，OPENAI_BASE_URL/ANTHROPIC_BASE_URL 填中转站地址；官方直连留空即可
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM 主链路（内容提取/摘要生成）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ========== JWT ==========
JWT_SECRET_KEY=change-me-to-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 存储 ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lingua-learner

# ========== AI 成本控制 ==========
DAILY_TOKEN_BUDGET_GPT4O=10000
DAILY_TOKEN_BUDGET_EMBEDDING=50000

# ========== 边缘设备管理 ==========
# 设备 UDP 广播端口，需与固件 kUdpPort 一致
EDGE_UDP_PORT=4210
# 单次局域网扫描监听窗口（秒）
EDGE_SCAN_TIMEOUT=3.0
# 固件仓库目录（相对 backend/）
EDGE_FIRMWARE_DIR=firmware
# 固件单文件大小上限（MB）
EDGE_FIRMWARE_MAX_MB=32
# 设备通信驱动：http | mock
#   http = 访问设备 HTTP 管理接口（默认，设备固件未实现时返回明确错误码）
#   mock = 无真机时模拟分片推送，用于演练 OTA 全流程
EDGE_DEVICE_DRIVER=http
