# ========== 应用 ==========
# 2026-09-29 APP_NAME 已移除：产品名改由 backend/app/core/constants.py 的 PRODUCT_NAME 统一提供，
# 此处不再覆盖，更名只改 constants.py 一处
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://lingua:lingua_dev@localhost:5432/lingua_dev
DATABASE_URL_SYNC=postgresql://lingua:lingua_dev@localhost:5432/lingua_dev

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== LLM 供应商 ==========
# 指定当前使用哪一家 LLM（取值为下面某一组的前缀）。
# 项目里所有需要调用 LLM 的地方（情境对话、学习报告等）都用这一家；也可在
# 「左上角李 → LLM Select」里随时切换，重启后仍以这里为准。
ACTIVE_LLM_PROVIDER=relay

# 在 .env 里定义几组，LLM Select 菜单就展示几项。
# 新增一家：复制下面一组、把前缀改成新名字、填好四项，
# 再把上面的 ACTIVE_LLM_PROVIDER 指过去，重启即可。
#   <前缀>_LLM_NAME           展示名（可选，缺省用兜底名）
#   <前缀>_LLM_BASE_URL       请求地址（必填）
#   <前缀>_LLM_API_KEY        API Key（可先留空，之后在 LLM Select 里补）
#   <前缀>_LLM_MODEL          模型名，多个用逗号分隔（必填）
#   <前缀>_LLM_NO_JSON_MODELS 不支持 JSON 输出的模型，逗号分隔（可选）
RELAY_LLM_NAME=MicuAPI 中转站
RELAY_LLM_BASE_URL=https://www.micuapi.ai/v1
RELAY_LLM_API_KEY=
RELAY_LLM_MODEL=gpt-4o

DEEPSEEK_LLM_NAME=DeepSeek
DEEPSEEK_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-chat,deepseek-reasoner
# deepseek-reasoner 是思考模型，官方不支持 JSON Output，需要单独关掉
DEEPSEEK_LLM_NO_JSON_MODELS=deepseek-reasoner

STEPFUN_LLM_NAME=StepFun 阶跃星辰
STEPFUN_LLM_BASE_URL=https://api.stepfun.com/v1
STEPFUN_LLM_API_KEY=
STEPFUN_LLM_MODEL=step-2-16k,step-1-8k,step-1-flash

# ========== LLM 主链路（备用） ==========
# 走中转站 Anthropic Messages 格式。当前代码未使用，保留配置备用。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ========== JWT ==========
JWT_SECRET_KEY=change-me-to-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 存储 ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lingua-learner

# ========== AI 成本控制 ==========
DAILY_TOKEN_BUDGET_GPT4O=10000
# 2026-10-01 DAILY_TOKEN_BUDGET_EMBEDDING 随 embedding 功能下线，已无对应配置项

# ========== 边缘设备管理 ==========
# 设备 UDP 广播端口，需与固件 kUdpPort 一致
EDGE_UDP_PORT=4210
# 单次局域网扫描监听窗口（秒）
EDGE_SCAN_TIMEOUT=3.0
# 固件仓库目录（相对 backend/）
EDGE_FIRMWARE_DIR=firmware
# 固件单文件大小上限（MB）
EDGE_FIRMWARE_MAX_MB=32
# 设备通信驱动：http | mock
#   http = 访问设备 HTTP 管理接口（默认，设备固件未实现时返回明确错误码）
#   mock = 无真机时模拟分片推送，用于演练 OTA 全流程
EDGE_DEVICE_DRIVER=http

# ========== 世势洞察 ==========
# 定时任务总开关：false 时后端不自动抓取/生成日报，只保留页面上的手动按钮
NEWS_SCHEDULER_ENABLED=true
# 定时抓取节奏（分钟）
NEWS_FETCH_INTERVAL_MINUTES=30
# 每日生成日报的时刻（24 小时制，按固定 UTC+8）
NEWS_DIGEST_HOUR=8
# 单个源抓取超时（秒）
NEWS_FETCH_TIMEOUT_SECONDS=15
# 单板块 LLM 摘要超时（秒），超时走降级稿
# reasoning 模型单次要 1-2 分钟，别调太低
NEWS_DIGEST_LLM_TIMEOUT_SECONDS=240
# 日报取材窗口（小时）：取当日往前这么久抓到的文章
NEWS_ARTICLE_WINDOW_HOURS=36
# 单板块送入 LLM 的最大文章数（控制成本）
NEWS_MAX_ARTICLES_PER_DIGEST=40
